{
  "name": "study-grove",
  "private": true,
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});for(const p of ['index.html','manifest.webmanifest','sw.js','css','fonts','icons','js','vendor'])fs.cpSync(p,'www/'+p,{recursive:true})\"",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
